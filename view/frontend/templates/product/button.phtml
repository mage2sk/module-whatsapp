declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Panth\WhatsApp\ViewModel\Product as ProductViewModel;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ProductViewModel $viewModel */

$viewModel = $block->getViewModel();

if (!$viewModel || !$viewModel->isEnabled()) {
    return;
}

$product = $viewModel->getProduct();
if (!$product) {
    return;
}

$whatsappUrl = $viewModel->getWhatsAppUrl();
if (!$whatsappUrl) {
    return;
}

$buttonText = $viewModel->getButtonText();
$buttonStyle = $viewModel->getButtonStyle();
$customClasses = $viewModel->getCustomCssClasses();

// Map admin style to CSS class
$styleClass = match ($buttonStyle) {
    'solid' => 'wa-style-solid',
    'outline' => 'wa-style-outline',
    'icon_only' => 'wa-style-icon',
    default => 'wa-style-text',
};
?>

<style>
    .wa-product-cta {
        clear: both;
        display: flex;
        margin: 16px 0 8px;
    }
    .wa-product-cta .wa-product-btn {
        --panth-wa-strong: color-mix(in srgb, var(--whatsapp-button-bg, #25D366) 55%, #000);
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        max-width: 100%;
        min-height: 44px;
        margin: 0;
        line-height: 1.2;
        text-decoration: none;
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .wa-product-cta .wa-product-btn svg {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
        fill: var(--panth-wa-strong);
    }
    .wa-product-cta .wa-product-btn:not(.wa-style-icon),
    .wa-product-cta .wa-product-btn:not(.wa-style-icon):visited {
        padding: 0 16px;
        border: 1px solid var(--ds-border-strong, var(--pt-border-strong, #D4D4D4));
        border-radius: var(--ds-radius-md, var(--pt-radius-md, 8px));
        background: var(--ds-surface, var(--pt-surface, #FFFFFF));
        color: var(--ds-text, var(--pt-text, #171717));
        font-size: 15px;
        font-weight: 600;
    }
    .wa-product-cta .wa-product-btn:not(.wa-style-icon):hover {
        border-color: var(--ds-brand, var(--pt-brand, #0F766E));
        background: var(--ds-brand-tint, var(--pt-brand-tint, #F0FDFA));
        color: var(--ds-text, var(--pt-text, #171717));
        text-decoration: none;
    }
    .wa-product-cta .wa-product-btn:focus-visible {
        outline: 2px solid var(--ds-brand, var(--pt-brand, #0F766E));
        outline-offset: 2px;
    }
    .wa-product-cta .wa-product-btn.wa-style-icon {
        width: 44px;
        height: 44px;
        padding: 0;
        border: 1px solid var(--ds-border-strong, var(--pt-border-strong, #D4D4D4));
        border-radius: 9999px;
        background: var(--ds-surface, var(--pt-surface, #FFFFFF));
    }
    .wa-product-cta .wa-product-btn.wa-style-icon .wa-btn-label {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    @media (max-width: 767px) {
        .wa-product-cta .wa-product-btn:not(.wa-style-icon) {
            width: 100%;
            min-height: 48px;
        }
        .wa-product-cta .wa-product-btn.wa-style-icon {
            width: 48px;
            height: 48px;
        }
    }
</style>

<div class="wa-product-cta">
<a
    href="<?= $escaper->escapeUrl($whatsappUrl) ?>"
    target="_blank"
    rel="noopener noreferrer"
    class="wa-product-btn <?= $escaper->escapeHtmlAttr($styleClass) ?> <?= $escaper->escapeHtmlAttr($customClasses) ?>"
    title="<?= $escaper->escapeHtmlAttr($buttonText) ?>"
    aria-label="<?= $escaper->escapeHtmlAttr($buttonText) ?>"
>
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path d="M16.002 0C7.165 0 0 7.165 0 16.002c0 2.825.745 5.479 2.044 7.796L.068 31.93l8.353-2.002A15.908 15.908 0 0 0 16.002 32C24.837 32 32 24.835 32 16.002 32 7.165 24.837 0 16.002 0zm9.381 22.837c-.383 1.077-1.905 1.973-3.124 2.23-.835.175-1.926.316-5.597-1.204-4.696-1.944-7.722-6.675-7.956-6.98-.223-.306-1.859-2.474-1.859-4.717 0-2.243 1.175-3.345 1.593-3.801.419-.456.912-.57 1.217-.57.305 0 .609.002.876.014.28.013.656-.107.928.707.383.917 1.303 3.176 1.416 3.407.113.232.189.503.038.809-.151.306-.227.497-.451.764-.224.268-.471.597-.672.801-.224.227-.458.472-.197.925.261.454 1.159 1.911 2.487 3.096 1.71 1.524 3.15 2.001 3.594 2.228.444.227.704.189.963-.113.259-.302 1.111-1.293 1.407-1.738.296-.445.593-.371 1-.223.406.148 2.585 1.218 3.029 1.44.444.223.74.334.847.519.107.185.107 1.074-.276 2.151z"/>
    </svg>
    <span class="wa-btn-label"><?= $escaper->escapeHtml($buttonText) ?></span>
</a>
</div>

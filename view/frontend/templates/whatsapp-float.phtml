<script>
    (function() {
        var button = document.getElementById('<?= $escaper->escapeJs($uniqueId) ?>');
        if (!button) return;

        // Show button with animation after 1 second
        setTimeout(function() {
            button.style.opacity = '1';
            button.style.transform = 'scale(1)';

            // Add pulse animation
            button.classList.add('pulse-active');

            // Remove pulse after 3 seconds
            setTimeout(function() {
                button.classList.remove('pulse-active');
            }, 3000);
        }, 1000);

        // Stop pulse on hover
        button.querySelector('.whatsapp-float-link').addEventListener('mouseenter', function() {
            button.classList.remove('pulse-active');
        });

        var avoidSelector = '#filters-heading button, [x-ref="LayeredNavigationMobileToggleIcon"],'
            + ' #layered-filter-block .filter-title [data-role="title"], #layered-filter-block .filter-options-title,'
            + ' [aria-label="Product filters"] .filter-options-title, .filter-current a, .filter-current button,'
            + ' .filter-actions a, .toolbar-products .sorter, .toolbar-products .modes-mode,'
            + ' .toolbar-products .pages a, [data-panth-float-avoid]';
        var pending = false;

        function coversControl() {
            var f = button.getBoundingClientRect();
            if (f.width < 2 || f.height < 2) {
                return false;
            }
            var gap = 8;
            var nodes = document.querySelectorAll(avoidSelector);
            for (var i = 0; i < nodes.length; i++) {
                var r = nodes[i].getBoundingClientRect();
                if (r.width < 2 || r.height < 2) {
                    continue;
                }
                if (r.right > f.left - gap && r.left < f.right + gap && r.bottom > f.top - gap && r.top < f.bottom + gap) {
                    return true;
                }
            }
            return false;
        }

        function update() {
            pending = false;
            button.classList.toggle('panth-wa-float--yield', coversControl());
        }

        function schedule() {
            if (!pending) {
                pending = true;
                window.requestAnimationFrame(update);
            }
        }

        window.addEventListener('scroll', schedule, {passive: true});
        window.addEventListener('resize', schedule);
        window.addEventListener('load', schedule);
        document.addEventListener('click', function() {
            setTimeout(schedule, 400);
        }, true);
        setTimeout(schedule, 1100);
    })();
</script>
